FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# Install retraining-only dependencies first for better layer caching.
COPY requirements-retrain.txt /app/requirements-retrain.txt
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r /app/requirements-retrain.txt

# Copy project source.
COPY . /app

# Run automated retraining job.
CMD ["python", "-m", "ml.retrain"]
